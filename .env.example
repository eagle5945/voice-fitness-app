# Local deployment reference only. The PWA and package builder do not load this file.
# Copy to .env and fill in your own values. Never put this file in pwa/ or site/.
NAS_SSH_HOST=nas.example.invalid
NAS_SSH_USER=deploy-user
NAS_SSH_KEY_PATH=C:/path/to/private-key
NAS_APP_DIR=/path/to/voice-fitness-pwa
APP_PUBLIC_URL=https://workout.example.invalid

# Optional local backup inventory
BACKUP_PARSER_DIR=
BACKUP_DICTATION_DIR=
BACKUP_CSV_DIR=
BACKUP_UX_DIR=

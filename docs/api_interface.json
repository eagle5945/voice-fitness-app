{
  "data_models": {
    "User": {
      "id": "uuid",
      "username": "string",
      "settings": {
        "unit_preference": "enum(kg, lbs)",
        "voice_wake_word_enabled": "boolean"
      }
    },
    "Workout": {
      "id": "uuid",
      "user_id": "uuid",
      "name": "string",
      "timestamp": "iso8601",
      "exercises": "list<ExerciseSession>"
    },
    "ExerciseSession": {
      "id": "uuid",
      "exercise_id": "uuid",
      "target_weight": "float",
      "target_reps": "integer",
      "sets": "list<Set>"
    },
    "Set": {
      "id": "uuid",
      "weight": "float",
      "reps": "integer",
      "status": "enum(success, failure, partial)",
      "recorded_at": "iso8601",
      "raw_transcript": "string"
    }
  },
  "service_interfaces": {
    "IVoiceProcessor": {
      "method": "process_voice_input",
      "parameters": {
        "audio_data": "blob",
        "current_context": "ExerciseSession"
      },
      "returns": {
        "success": "boolean",
        "parsed_set": "Set",
        "error": "string"
      }
    },
    "IWorkoutRepository": {
      "methods": {
        "save_set": {
          "parameters": {
            "set": "Set"
          },
          "returns": "boolean"
        },
        "get_workout_history": {
          "parameters": {
            "user_id": "uuid"
          },
          "returns": "list<Workout>"
        }
      }
    }
  }
}